def GAR_HOST = 'us-east4-docker.pkg.dev'
def GAR_REPO = "${GAR_HOST}/${env.GCP_PROJECT}/default-gar"

pipeline {
    agent none
    options {
        timestamps()
    }
    triggers {
        cron('H 2 * * 0')  // Sundays ~2 AM; keeps base image deps fresh
    }
    stages {
        stage('Build and Push') {
            agent {
                kubernetes {
                    yaml """
                        apiVersion: v1
                        kind: Pod
                        spec:
                          containers:
                          - name: dind
                            image: docker:27-dind
                            securityContext:
                              privileged: true
                            resources:
                              requests:
                                cpu: "1000m"
                                memory: "2Gi"
                              limits:
                                cpu: "2000m"
                                memory: "4Gi"
                    """
                }
            }
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                container('dind') {
                    withCredentials([file(credentialsId: 'jenkins-gke-sa', variable: 'GKE_SA_FILE')]) {
                        sh """
                            set -euo pipefail

                            # Authenticate to Google Artifact Registry
                            apk add --no-cache bash curl python3
                            curl -fsSL https://sdk.cloud.google.com | bash -s -- --disable-prompts
                            export PATH="\$HOME/google-cloud-sdk/bin:\$PATH"
                            gcloud auth activate-service-account --key-file "\$GKE_SA_FILE"
                            gcloud auth configure-docker ${GAR_HOST} --quiet

                            # Wait for Docker to be ready before building
                            while ! docker stats --no-stream 2>/dev/null; do
                                echo "Waiting for Docker to launch..."
                                sleep 1
                            done

                            # Build and push from repo root so COPY paths in the Dockerfile resolve correctly
                            docker buildx create --driver docker-container --name majordomo-builder --use || true
                            docker buildx build --push \\
                                --cache-to  type=registry,ref=${GAR_REPO}/minordomo-image-cache:latest,mode=max \\
                                --cache-from type=registry,ref=${GAR_REPO}/minordomo-image-cache:latest \\
                                -f minordomo-container-builder/Dockerfile \\
                                -t ${GAR_REPO}/minordomo-image:latest \\
                                .
                        """
                    }
                }
            }
        }
        stage('Build and Push Helm Image') {
            agent {
                kubernetes {
                    yaml """
                        apiVersion: v1
                        kind: Pod
                        spec:
                          containers:
                          - name: dind
                            image: docker:27-dind
                            securityContext:
                              privileged: true
                            resources:
                              requests:
                                cpu: "500m"
                                memory: "1Gi"
                              limits:
                                cpu: "1000m"
                                memory: "2Gi"
                    """
                }
            }
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                container('dind') {
                    withCredentials([file(credentialsId: 'jenkins-gke-sa', variable: 'GKE_SA_FILE')]) {
                        sh """
                            set -euo pipefail

                            apk add --no-cache bash curl python3
                            curl -fsSL https://sdk.cloud.google.com | bash -s -- --disable-prompts
                            export PATH="\$HOME/google-cloud-sdk/bin:\$PATH"
                            gcloud auth activate-service-account --key-file "\$GKE_SA_FILE"
                            gcloud auth configure-docker ${GAR_HOST} --quiet

                            while ! docker stats --no-stream 2>/dev/null; do
                                echo "Waiting for Docker to launch..."
                                sleep 1
                            done

                            docker buildx create --driver docker-container --name helm-builder --use || true
                            docker buildx build --push \\
                                --cache-to  type=registry,ref=${GAR_REPO}/jenkins-helm-cache:latest,mode=max \\
                                --cache-from type=registry,ref=${GAR_REPO}/jenkins-helm-cache:latest \\
                                -f minordomo-container-builder/Dockerfile.helm \\
                                -t ${GAR_REPO}/jenkins-helm:latest \\
                                .
                        """
                    }
                }
            }
        }
    }
    post {
        failure { notifyFailure() }
    }
}
