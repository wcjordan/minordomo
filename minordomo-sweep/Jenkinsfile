// Sweep job: resets stale in-progress beads tasks back to open.
// NOTE: A Jenkins pipeline job must be manually created in the Jenkins UI,
// pointing to minordomo-sweep/Jenkinsfile in this repo. It is not auto-created.

def GAR_HOST = 'us-east4-docker.pkg.dev'
def GAR_REPO = "${GAR_HOST}/${env.GCP_PROJECT}/default-gar"

pipeline {
    agent none
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    triggers {
        cron('H H/4 * * *')
    }
    stages {
        stage('Sweep Stale Tasks') {
            agent {
                kubernetes {
                    yaml """
                        apiVersion: v1
                        kind: Pod
                        spec:
                          containers:
                          - name: majordomo
                            image: ${GAR_REPO}/minordomo-image:latest
                            command:
                            - cat
                            tty: true
                            resources:
                              requests:
                                cpu: "100m"
                                memory: "256Mi"
                              limits:
                                cpu: "500m"
                                memory: "512Mi"
                    """
                }
            }
            environment {
                GH_APP    = credentials('github-app')
                JIRA_ACCT = credentials('jira-api-key')
            }
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                container('majordomo') {
                    sh '''
                        set -euo pipefail

                        source shared/setup-env.sh

                        gh auth setup-git
                        [ -d .beads ] && chmod 700 .beads
                        bd bootstrap -- --silent && bd dolt pull

                        shared/sweep-stale-tasks.sh

                        bd dolt push
                    '''
                }
            }
        }
    }
    post {
        failure { notifyFailure() }
    }
}
