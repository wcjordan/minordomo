def GAR_HOST = 'us-east4-docker.pkg.dev'
def GAR_REPO = "${GAR_HOST}/${env.GCP_PROJECT}/default-gar"

pipeline {
    agent none
    options {
        timestamps()
    }
    parameters {
        string(name: 'JIRA_TASK_ID', description: 'Jira planning task ID to plan (e.g. MDOMO-44)', trim: true)
    }
    stages {
        stage('Planning Agent') {
            agent {
                kubernetes {
                    yaml """
                        apiVersion: v1
                        kind: Pod
                        spec:
                          containers:
                          - name: worker
                            image: ${GAR_REPO}/minordomo-image:latest
                            command:
                            - cat
                            tty: true
                            resources:
                              requests:
                                cpu: "500m"
                                memory: "1Gi"
                              limits:
                                cpu: "1000m"
                                memory: "2Gi"
                    """
                }
            }
            environment {
                CLAUDE_CODE_OAUTH_TOKEN = credentials('claude-code-oauth-token')
                GH_APP                  = credentials('github-app')
                JIRA_ACCT               = credentials('jira-api-key')
            }
            options {
                timeout(time: 120, unit: 'MINUTES')
            }
            steps {
                container('worker') {
                    sh '''
                        set -euo pipefail

                        source shared/setup-env.sh
                        source shared/setup-claude.sh
                        source shared/setup-workspace.sh planning

                        { bd stats && echo "---" && bd list; } | tee /tmp/beads-output.txt
                        CLAUDE_EXIT=0
                        claude -p "$(cat ../minordomo-plan/system-prompt.md)" --output-format json \
                          > /tmp/claude-output.json || CLAUDE_EXIT=$?

                        bd dolt push
                        python3 ../shared/report-token-usage.py /tmp/claude-output.json 2>&1 | tee /tmp/prompt-output.txt || true
                        exit $CLAUDE_EXIT
                    '''
                }
            }
            post {
                always {
                    container('worker') {
                        script {
                            def output = sh(
                                script: 'cat /tmp/beads-output.txt /tmp/prompt-output.txt 2>/dev/null || true',
                                returnStdout: true
                            ).trim()
                            if (output) {
                                currentBuild.description = output
                            }
                        }
                    }
                }
            }
        }
        stage('Beads Status') {
            agent {
                kubernetes {
                    yaml """
                        apiVersion: v1
                        kind: Pod
                        spec:
                          containers:
                          - name: majordomo
                            image: ${GAR_REPO}/minordomo-image:latest
                            command:
                            - cat
                            tty: true
                            resources:
                              requests:
                                cpu: "100m"
                                memory: "256Mi"
                              limits:
                                cpu: "500m"
                                memory: "512Mi"
                    """
                }
            }
            environment {
                BEADS_DOLT_PASSWORD = credentials('dolt-minordomo-password')
                GH_APP                  = credentials('github-app')
                JIRA_ACCT           = credentials('jira-api-key')
            }
            options {
                timeout(time: 5, unit: 'MINUTES')
            }
            steps {
                container('majordomo') {
                    sh '''
                        set -euo pipefail
                        source shared/setup-env.sh

                        [ -d .beads ] && chmod 700 .beads
                        git config beads.role maintainer
                        bd bootstrap
                        bd dolt show
                        bd dolt pull
                        { bd stats && echo "---" && bd list; } | tee /tmp/beads-output.txt
                    '''
                }
            }
            post {
                always {
                    container('majordomo') {
                        script {
                            def beadsOutput = sh(
                                script: 'cat /tmp/beads-output.txt 2>/dev/null || true',
                                returnStdout: true
                            ).trim()
                            if (beadsOutput) {
                                def existing = currentBuild.description ?: ''
                                currentBuild.description = existing + (existing ? '\n\n---\n\n' : '') + beadsOutput
                            }
                        }
                    }
                }
            }
        }
    }
}
