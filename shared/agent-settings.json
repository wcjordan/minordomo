{
  "model": "claude-sonnet-4-6",
  "advisorModel": "claude-opus-4-7",
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "mcp__atlassian__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify*)",
      "Bash(git rebase*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(curl *metadata.google.internal*)",
      "Bash(curl *169.254.169.254*)"
    ]
  },
  "hooks": {
    "PreBashCommand": "~/.claude/hooks/pre-bash-guard.sh"
  }
}
